{
  "family": "ci-cd-ecs",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:ecs:us-east-1:254771353010:cluster/ci-cd-ecs",
  "containerDefinitions": [
    {
      "name": "ci-cd-task-service",
      "image": "254771353010.dkr.ecr.us-east-1.amazonaws.com/dev/ci-cd:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024"
}
